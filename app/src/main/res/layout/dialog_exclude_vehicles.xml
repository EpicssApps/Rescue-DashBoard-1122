<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Exclusion Filters"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select vehicle categories to ignore from out-of-sync alarms:"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <CheckBox
                    android:id="@+id/cb_ambulances"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🚑 Ambulances (BNA-, AMB)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_firetrucks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🚒 Firetrucks (BNF-, FIRE)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_rescue_vehicles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🛻 Rescue Vehicles (BNR-, RESCUE)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_bikes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🏍️ Rescue Bikes (BNB-, BIKE)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_gdv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🚐 General Duty Vans (BNG-, GDV)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_boats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🚤 Rescue Boats (BWN-BT-, BOAT)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_air_ambulance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🚁 Air Ambulances (AIR-AMB)"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_specialized"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="2dp"
                    android:text="🚜 Specialized Vehicles (SPEC)"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom Vehicle Prefixes (comma-separated)"
            app:helperText="e.g. KLR-, ABC-01">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_custom_prefixes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
